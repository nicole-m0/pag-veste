# Copie este arquivo para .env.local e preencha apenas o arquivo privado.
# Nunca registre credenciais reais neste arquivo ou no GitHub.

# PostgreSQL hospedado no Railway.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Cloudinary. Variáveis exclusivas do servidor: nunca use NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Protege operações administrativas da API. Gere um valor longo e aleatório.
ADMIN_API_KEY=""
