# Preencha estes valores somente em .env.local (desenvolvimento) e no painel da Vercel.
# Nunca faça commit de arquivos .env que contenham credenciais reais.

# PostgreSQL hospedado no Railway. Use a URL de conexão externa fornecida pelo Railway.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Cloudinary. Estas variáveis são exclusivas do servidor: não use o prefixo NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
